# ==============================================================================
# SMART WATER USAGE ADVISOR - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env for local development.
# DO NOT commit real passwords, credentials, or API keys to version control!
# ==============================================================================

# PostgreSQL Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=smart_water_advisor_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# SQLite Fallback Configuration (For local unit testing when PostgreSQL is unreachable)
USE_SQLITE_TEST_FALLBACK=True
SQLITE_DB_PATH=smart_water_advisor_test.db

# Synthetic Telemetry Generation Parameters
RANDOM_SEED=42
TELEMETRY_DAYS=90
READINGS_PER_DAY=24

# Security & App Settings
SECRET_KEY=your-secure-random-secret-key-here
DEBUG=True
